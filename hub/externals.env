# Shell-readable subset of externals.py (checked by hub/tests/test_externals.py). Source it; do not add logic here.
PLUGIN_NET_LIB=libbambu_networking.so
PLUGIN_FIND_PATTERNS="libbambu* libBambuSource* libagora* liblive555*"
BRIDGE_LIB_ENV=BAMBU_LIB_PATH
PLUGIN_AGENT_DIR=/tmp/bambu_agent
CERT_URL=https://raw.githubusercontent.com/bambulab/BambuStudio/master/resources/cert/slicer_base64.cer
FLATHUB_APP_ID=com.bambulab.BambuStudio
STUDIO_BINARY_NAMES="bambu-studio BambuStudio"
PROFILE_ROOT_FILE=BBL.json
PROFILE_DIR=BBL
PROFILE_SEARCH="*/profiles/BBL.json"
DEFAULT_PRINTER="Bambu Lab H2S 0.4 nozzle"
